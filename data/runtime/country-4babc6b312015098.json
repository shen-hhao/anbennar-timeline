8/gerudia/plan.json","sha256":"01b475f7cf104d243a9dbe5e79555e54e50716f88e3dfe6ee7248b7c0f317997","status":"reviewed-inference","independentHistoricalProof":false}},{"id":"wc080-north-vic-league-cutoff-1581","year":1581,"title":"Bayvic商盟两成员关系截止观察（1581推演）","description":"Frostwall和Everwharf在1444仍隶属范围外的Bayvic商盟。外交历史把Z33、Z30的vic_league_member关系都列为1380.1.1—1581.1.1；本推测层以1581结束旧商盟附属显示，地方owner及省形不变。共同截止可能是脚本历史约束，不称1581独立战争或建国，之后至1660整合前的无该附属显示也只是模型选择。","kind":"hypothesis","stepId":"wc080-north-vic-league-cutoff-1581","sourceIds":["wc080-north-vic-league-diplomacy","wc080-north-baseline","wc080-reasoning-north"],"dateEvidence":{"exactYear":null,"earliest":1445,"latest":1660,"observedYear":1581,"chosenYear":1581,"sourceClaimedYear":1581,"scriptEndDate":"1581.1.1","dateIsHistoricalFact":false,"precision":"script_history_cutoff_scenario_observation","sourceLocator":{"Z30":[36,42],"Z33":[50,56]},"basis":"实际外交历史为两条Bayvic商盟成员关系列同一1581.1.1结束日期。采用该有来源的脚本截止作为展示年；1445—1660为开局后到既有加韦德整合方案前的宽解释窗，不是源码给出的历史独立窗口。"},"geometryNote":"没有领土更新：706 Frostwall继续Z33，722 Everwharf继续Z30，直到已有1660加韦德整合推演。Bayvic三省不在当前486省范围，不新增其领土。","provinceIds":[706,722],"updates":[],"removeRelations":["Z30","Z33"],"changedProvinceIdsByEvidence":{"reconstructed":[706,722],"attested":[]},"territorialChangeProvinceIdsByEvidence":{"reconstructed":[706,722],"attested":[]},"reasoning":"地图范围边缘不能因宗主未绘制就把成员提前显示为独立。先保留1444起的范围外宗主上下文，再用实际脚本共同截止1581作为可关闭的关系结束观察；它不证明国家成立、城市独立或一次战争。","alternatives":["1581可能是开发使用的统一历史截止；可将商盟关系保留至1660整合前再终止。","真实脱盟也可能分年发生，缺少进一步文献时不虚构两场独立战争。"],"inferenceReview":{"plan":"docs/research/west080/north-plan.json","sha256":"d179625e6e9f1dd394b28afb9ae04c9e11ed950af8ff955ad4a16eeadde2c290","status":"reviewed-inference","independentHistoricalProof":false}},{"id":"ca09-text-ge26-bayvic-rights-1584","year":1584,"endYear":null,"title":"1584：贝维克哥布林争取到平等公民权","description":"官方理念原文与固定维基均记述一场争议审判引发抗议，谈判后哥布林取得法律平等、投票与被选举权。这里采用官方理念的社会制度纪年，未认定商盟在1584解散，亦不覆盖既有1581商盟关系截止推演。","kind":"attested","sourceIds":["manual:ge26-mod